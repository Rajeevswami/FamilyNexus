# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=familynexus
DB_USER=familynexus
DB_PASSWORD=familynexus
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Sentry (production only)
SENTRY_DSN=

# Email (console backend by default — safe for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FamilyNexus <no-reply@familynexus.app>

# Used to build links in emails (password reset, welcome)
FRONTEND_URL=http://localhost:5173

# Billing. Leave blank to use the manual provider in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FAMILY_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# console, sendgrid, or ses. SES uses EMAIL_BACKEND (for example django_ses.SESBackend).
EMAIL_PROVIDER=console
SENDGRID_API_KEY=

# Fernet key for provider secrets stored in the database. Generate with cryptography.fernet.Fernet.generate_key().
FIELD_ENCRYPTION_KEY=

# Object storage for uploaded documents and avatars. Leave all three of
# AWS_STORAGE_BUCKET_NAME / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty to
# keep files on the local disk (correct for development). On any host with an
# ephemeral filesystem — Render, Railway, Fly, Cloud Run — leaving them empty
# means every upload is deleted on the next deploy. Any S3-compatible provider
# works (Cloudflare R2, Backblaze B2, Supabase Storage, MinIO, AWS S3).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Content-Security-Policy for JSON API responses. In production a strict
# policy is applied by default and this key is left unset. Set it to an empty
# value to turn the header off when an upstream proxy already sets its own CSP,
# or to a full policy string to override it.
# CONTENT_SECURITY_POLICY=

# Optional product and assistant integrations. Empty values disable the network call.
ANTHROPIC_API_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
VAULT_ADDR=
VAULT_TOKEN=
